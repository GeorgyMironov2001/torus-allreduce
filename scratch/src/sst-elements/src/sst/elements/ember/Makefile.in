mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f libs/*.$(OBJEXT)
	-rm -f libs/*.lo
	-rm -f mpi/*.$(OBJEXT)
	-rm -f mpi/*.lo
	-rm -f mpi/motifs/*.$(OBJEXT)
	-rm -f mpi/motifs/*.lo
	-rm -f shmem/*.$(OBJEXT)
	-rm -f shmem/*.lo
	-rm -f tools/embertricount/*.$(OBJEXT)
	-rm -f tools/meshconverter/*.$(OBJEXT)
	-rm -f tools/spygen/*.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

