	-$(am__rm_f) shmem/$(am__dirstamp)
	-$(am__rm_f) tools/embertricount/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) tools/embertricount/$(am__dirstamp)
	-$(am__rm_f) tools/meshconverter/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) tools/meshconverter/$(am__dirstamp)
	-$(am__rm_f) tools/spygen/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) tools/spygen/$(am__dirstamp)

maintainer-clean-generic:
	@echo "This command is intended for maintainers to use"
	@echo "it deletes files that may require special tools to rebuild."
	-$(am__rm_f) $(BUILT_SOURCES)
