@HAVE_PIN3_TRUE@@HAVE_PINTOOL_TRUE@@SST_COMPILE_OSX_FALSE@all-local : fesimple.so

@HAVE_PIN325_TRUE@@HAVE_PIN3_TRUE@@HAVE_PINTOOL_TRUE@@SST_COMPILE_OSX_FALSE@fesimple.so : fesimple.o
@HAVE_PIN325_TRUE@@HAVE_PIN3_TRUE@@HAVE_PINTOOL_TRUE@@SST_COMPILE_OSX_FALSE@	$(CXX) -shared -Wl,--hash-style=sysv \
@HAVE_PIN325_TRUE@@HAVE_PIN3_TRUE@@HAVE_PINTOOL_TRUE@@SST_COMPILE_OSX_FALSE@	    $(PINTOOL_DIR)/$(TARGET)/runtime/pincrt/crtbeginS.o \
@HAVE_PIN325_TRUE@@HAVE_PIN3_TRUE@@HAVE_PINTOOL_TRUE@@SST_COMPILE_OSX_FALSE@	    -Wl,-Bsymbolic -Wl,--version-script=$(PINTOOL_DIR)/source/include/pin/pintool.ver \
@HAVE_PIN325_TRUE@@HAVE_PIN3_TRUE@@HAVE_PINTOOL_TRUE@@SST_COMPILE_OSX_FALSE@	    -o fesimple.so fesimple.o \
